# DealMind + IntentLock Server Environment Configuration
# Copy this file to `server/.env` (or project root `.env`).
# NEVER commit real credentials to version control.

# Network & Runtime Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=data/dealmind.sqlite
APPROVAL_VALIDITY_SECONDS=900
TOKEN_HMAC_SECRET=placeholder_secret_replace_in_production

# PayPal Sandbox Configuration (Sandbox ONLY - Live PayPal is strictly prohibited)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Provider Configuration
# Supported providers: 'mock' (default, offline, zero-cost) or 'openai' | 'anthropic' | 'gemini' | 'groq'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
